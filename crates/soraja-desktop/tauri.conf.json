{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
  "productName": "SORAJA ENGINE",
  "version": "1.0.0",
  "identifier": "com.soraja.engine",
  "build": {
    "beforeDevCommand": "pnpm --filter desktop-ui dev",
    "beforeBuildCommand": "pnpm --filter desktop-ui build",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../../desktop-ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "SORAJA ENGINE — Command Center",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 680,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
