---
import '../styles/global.css';

interface Props {
  title?: string;
}
const { title = "SORAJA ENGINE — Autonomous Agentic Command Center" } = Astro.props;
---
<!doctype html>
<html lang="id" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="icon" type="image/png" href="/logo.png" />
  </head>
  <body>
    <slot />
  </body>
</html>
