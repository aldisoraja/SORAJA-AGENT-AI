---
/** Katalog agen & model (diambil dari daftar model CLI asli, 13 Okt 2026) dan fitur utama aplikasi. */
const agents = [
  {
    tag: 'Claude', cls: 'claude-tag', title: 'Claude Code (claude)',
    desc: 'Agen coding Anthropic untuk refactor terstruktur, membaca gambar & PDF, dan verifikasi build/tes.',
    pills: ['Opus 5.5 · Sonnet 5.5 · Haiku 5.5', 'Effort hingga Maksimum'],
  },
  {
    tag: 'Codex', cls: 'openai-tag', title: 'OpenAI Codex (codex)',
    desc: 'Agen OpenAI dengan gambar terlampir langsung ke prompt dan penalaran hingga xhigh.',
    pills: ['gpt-6-luna · gpt-5.6-terra · gpt-5.6-luna', 'Akun ChatGPT/OpenAI Anda'],
  },
  {
    tag: 'Antigravity', cls: 'google-tag', title: 'Google Antigravity (agy)',
    desc: 'Agen otonom Google untuk vibe coding; varian model sudah memuat level penalaran.',
    pills: ['Gemini 3.8 Flash (Low/Medium/High)', 'Claude 4.6 · GPT-OSS 120B'],
  },
  {
    tag: 'OpenCode', cls: 'open-tag', title: 'OpenCode (opencode)',
    desc: 'Agen multi-provider — puluhan model, termasuk model gratis. Model tanpa dukungan gambar ditandai di aplikasi.',
    pills: ['Multi-provider', 'Indikator model vision'],
  },
  {
    tag: 'Kiro', cls: 'kiro-tag', title: 'Kiro CLI (kiro-cli)',
    desc: 'Agen spec-driven dari AWS. Chat GUI dan Terminal memakai login Kiro yang sama; di mode aman tetap bisa membaca & mengubah berkas.',
    pills: ['Model dari --list-models', 'Resume sesi per ID'],
  },
];

const features = [
  { icon: '🧠', title: 'Penalaran Chat lebih dalam', body: 'Di Chat GUI, setiap agen bernalar lebih dalam daripada di Terminal. Pilih Tinggi, Sangat tinggi, atau Maksimum di Pengaturan.' },
  { icon: '🖼️', title: 'Hingga 10 gambar per pesan', body: 'Tempel atau seret screenshot, foto struk, atau grafik. Agen membaca teks, angka, dan detail visualnya — bahkan menemukan total invoice yang salah hitung. Klik gambar untuk memperbesar, lalu pindah dengan tombol atau panah ← →.' },
  { icon: '📄', title: 'PDF, Word, Excel & PowerPoint', body: 'Lampirkan dokumen kantor dan CSV. Isi Word, Excel, dan PowerPoint diekstrak otomatis menjadi teks & tabel, sehingga kelima agen bisa membacanya meski di mode aman.' },
  { icon: '🎯', title: 'Pesan panjang, tak ada yang terlewat', body: 'Satu pesan berisi banyak permintaan dijawab satu per satu. Jawaban berlanjut dalam percakapan yang sama, jadi Anda bisa bertanya lanjutan tanpa mengulang konteks.' },
  { icon: '🧭', title: 'Proses kerja yang transparan', body: 'Alur langsung: berpikir, membaca berkas, mencari, menjalankan perintah, dan mengubah kode, dengan penjelasan agen tepat di bawah tiap langkah. Selama agen bekerja, baris status menempel di atas sehingga progres selalu terlihat. Baca berkas berurutan diringkas jadi satu baris "Menelusuri kode", dan setelah selesai total token (atau kredit Kiro) tampil di baris status.' },
  { icon: '🔍', title: 'Tinjau perubahan sebelum diterima', body: 'Setiap berkas yang diubah agen tampil sebagai diff +/− dan bisa ditinjau satu per satu sebelum Anda menerimanya.' },
  { icon: '🛡️', title: 'Izin sebelum perintah berisiko', body: 'Perintah terminal berisiko menunggu persetujuan Anda: izinkan sekali, untuk percakapan, proyek, atau global — atau tolak. Bisa lewat keyboard (↑/↓, 1–5, Enter, Esc). Perintah baca-saja di Mode Aman berjalan otomatis, dan agen melanjutkan di giliran yang sama.' },
  { icon: '📋', title: 'Salin dengan satu klik', body: 'Salin pesan Anda, jawaban agen, atau blok kode mana pun. Jawaban berformat rapi: heading, tabel, kode berlabel, dan rumus yang mudah dibaca.' },
  { icon: '🖥️', title: 'Chat GUI + Terminal asli', body: 'Satu percakapan bisa dilanjutkan di tab Terminal (ConPTY) dengan CLI aslinya — slash command, login, dan /model tetap utuh.' },
  { icon: '🗂️', title: 'Banyak terminal, jalan bersamaan', body: 'Buka beberapa tab Terminal sekaligus, satu tab untuk satu folder proyek. Semua agen terus bekerja di latar belakang saat Anda pindah tab atau ke Chat GUI; di Windows, tombol Stop menghentikan seluruh proses agen sampai tuntas.' },
  { icon: '🔁', title: 'Ganti agen tanpa kehilangan tempat', body: 'Ganti Claude, Codex, atau agen lain di folder yang sama lewat satu tombol. Tab Anda tetap di tempatnya, tidak meloncat ke proyek lain.' },
  { icon: '⭐', title: 'Favorit & riwayat bersih', body: 'Tandai bintang pada percakapan penting lalu temukan lagi lewat menu Favorit. Daftar sesi menampilkan waktu relatif (Baru saja, 5 mnt, Kemarin), dan sesi Terminal otomatis diberi label dari perintah pertama Anda.' },
  { icon: '🎨', title: 'Tampilan nyaman di mata', body: 'Tema terang dengan gradasi lembut, warna terminal dan diff yang jelas di latar putih, plus pilihan ukuran tampilan dan mode kurangi animasi.' },
  { icon: '🔔', title: 'Dikabari saat AI selesai', body: 'Bunyi dan tanda di judul jendela muncul saat agen selesai menjawab, jadi Anda bisa mengerjakan hal lain sambil menunggu.' },
  { icon: '💬', title: 'Jawaban Bahasa Indonesia', body: 'Semua agen otomatis menjawab dalam Bahasa Indonesia yang jelas — bahkan bila Anda bertanya dalam Bahasa Inggris — baik di Chat maupun di Terminal.' },
  { icon: '🔐', title: 'Akun & kredensial aman', body: 'Memakai login CLI Anda sendiri. API key opsional disimpan di Windows Credential Manager (DPAPI), bukan teks biasa.' },
];
---

<section id="model-ai" class="matrix-section">
  <div class="section-badge-center">5 AGEN CLI RESMI</div>
  <h2 class="section-heading">Satu aplikasi, lima agen coding</h2>
  <p class="section-desc">Soraja menjalankan CLI resmi di komputer Anda — langganan Anda sendiri, tanpa perantara.</p>

  <div class="matrix-grid">
    {agents.map((a) => (
      <div class="matrix-card">
        <div class="matrix-header">
          <span class={`vendor-tag ${a.cls}`}>{a.tag}</span>
          <h4>{a.title}</h4>
        </div>
        <p class="matrix-desc">{a.desc}</p>
        <div class="matrix-pills">{a.pills.map((p) => <span>{p}</span>)}</div>
      </div>
    ))}
  </div>
</section>

<section id="fitur" class="pillars-section">
  <div class="section-badge-center">FITUR UTAMA</div>
  <h2 class="section-heading">Dirancang agar hasil agen akurat & mudah dipahami</h2>

  <div class="pillars-grid features-grid">
    {features.map((f) => (
      <div class="pillar-card">
        <div class="pillar-icon">{f.icon}</div>
        <h3>{f.title}</h3>
        <p>{f.body}</p>
      </div>
    ))}
  </div>
</section>
