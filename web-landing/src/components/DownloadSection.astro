---
/**
 * Bagian Unduh: tautan langsung ke installer di /downloads/<versi>/ dari manifest
 * `src/data/releases.json` (ditulis `scripts/publish-release.mjs`). Berkas yang belum dibangun
 * ditampilkan "Belum tersedia" — tidak ada pengalihan ke halaman lain.
 */
import releases from '../data/releases.json';

type ReleaseFile = {
  id: string; os: string; arch: string; label: string; file: string; url: string; sizeBytes: number; sha256: string;
};
const files = releases.files as ReleaseFile[];
const mb = (b: number) => `${(b / 1024 / 1024).toLocaleString('id-ID', { maximumFractionDigits: 1 })} MB`;
const releasedAt = releases.releasedAt
  ? new Date(releases.releasedAt).toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' })
  : '';

const platforms = [
  {
    os: 'windows', icon: '🪟', title: 'Windows', compat: 'Windows 10 & 11 (64-bit)', chip: 'Rekomendasi',
    notes: ['Kredensial di Windows Credential Manager (DPAPI)', 'Terminal asli via ConPTY'],
    missing: 'Installer Windows untuk versi ini belum diterbitkan.',
  },
  {
    os: 'linux', icon: '🐧', title: 'Linux', compat: 'Ubuntu, Debian, Fedora, Arch (x64)', chip: 'Beta',
    notes: ['Paket .deb & AppImage portabel', 'Membutuhkan WebKitGTK 4.1'],
    missing: 'Paket Linux untuk versi ini belum diterbitkan.',
  },
  {
    os: 'macos', icon: '🍎', title: 'macOS', compat: 'Apple Silicon & Intel', chip: 'Segera',
    notes: ['Build macOS memerlukan perangkat Mac', 'Pantau halaman ini untuk rilisnya'],
    missing: 'Belum tersedia untuk macOS.',
  },
].map((p) => ({ ...p, files: files.filter((f) => f.os === p.os) }));
---

<div id="downloads" class="download-section">
  <div class="section-badge-center">UNDUH APLIKASI DESKTOP</div>
  <h2 class="section-heading">Unduh SORAJA ENGINE v{releases.version}</h2>
  <p class="section-desc">
    Klik tombol untuk langsung mengunduh installer.
    {releasedAt && <span> Dirilis {releasedAt}.</span>}
  </p>

  <div class="download-grid">
    {platforms.map((p) => (
      <div class="os-card" data-os-card={p.os}>
        <div class="card-top">
          <div class="os-avatar">{p.icon}</div>
          <span class="os-chip os-detected-chip" hidden>Perangkat Anda</span>
          <span class="os-chip os-default-chip">{p.chip}</span>
        </div>
        <h3 class="os-title">{p.title}</h3>
        <p class="os-compat">{p.compat}</p>
        <div class="os-features">
          {p.notes.map((n) => <span>✓ {n}</span>)}
        </div>

        {p.files.length > 0 ? (
          <div class="dl-list">
            {p.files.map((f) => (
              <div class="dl-item">
                <a class="btn-card-download dl-link" href={f.url} download={f.file}>
                  <span class="dl-icon" aria-hidden="true">⬇</span>
                  <span class="dl-label">{f.label}</span>
                  <span class="dl-size">{mb(f.sizeBytes)}</span>
                </a>
                <button type="button" class="dl-hash" data-copy={f.sha256} title="Salin SHA-256 untuk verifikasi berkas">
                  SHA-256 <code>{f.sha256.slice(0, 12)}…</code> <span class="dl-hash-action">Salin</span>
                </button>
              </div>
            ))}
          </div>
        ) : (
          <div class="dl-list">
            <span class="btn-card-download is-disabled" aria-disabled="true">Belum tersedia</span>
            <p class="dl-missing">{p.missing}</p>
          </div>
        )}
      </div>
    ))}
  </div>

  <div class="requirements-card">
    <div class="req-col">
      <h3>Sebelum mulai</h3>
      <p>
        SORAJA ENGINE menjalankan CLI agen resmi yang terpasang di komputer Anda dan memakai akun langganan Anda
        sendiri. Pasang minimal satu CLI, lalu login sekali di tab Terminal aplikasi.
      </p>
      <ul class="req-list">
        <li><span>Claude Code</span><code>npm i -g @anthropic-ai/claude-code</code></li>
        <li><span>OpenAI Codex</span><code>npm i -g @openai/codex</code></li>
        <li><span>OpenCode</span><code>npm i -g opencode-ai</code></li>
        <li><span>Antigravity</span><em>pasang CLI <code>agy</code> dari Google Antigravity</em></li>
      </ul>
    </div>
    <div class="req-col">
      <h3>Verifikasi & keamanan</h3>
      <p>
        Bandingkan SHA-256 berkas yang Anda unduh dengan nilai di atas. Di Windows:
      </p>
      <code class="req-code">Get-FileHash .\soraja-engine_{releases.version}_x64.msi</code>
      <p class="req-note">
        Installer belum ditandatangani sertifikat kode, jadi Windows SmartScreen dapat menampilkan peringatan.
        Pilih <strong>More info → Run anyway</strong> bila hash cocok.
      </p>
    </div>
  </div>
</div>

<script is:inline>
  (() => {
    const ua = navigator.userAgent;
    const os = /Windows/i.test(ua) ? 'windows' : /Mac OS X|Macintosh/i.test(ua) ? 'macos' : /Linux|X11/i.test(ua) ? 'linux' : '';
    const card = os && document.querySelector(`[data-os-card="${os}"]`);
    if (card) {
      card.classList.add('highlight-card');
      card.querySelector('.os-detected-chip')?.removeAttribute('hidden');
      card.querySelector('.os-default-chip')?.setAttribute('hidden', '');
    }
    document.querySelectorAll('.dl-hash').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const label = btn.querySelector('.dl-hash-action');
        try {
          await navigator.clipboard.writeText(btn.getAttribute('data-copy') || '');
          if (label) label.textContent = 'Tersalin ✓';
        } catch {
          if (label) label.textContent = 'Gagal';
        }
        setTimeout(() => label && (label.textContent = 'Salin'), 1600);
      });
    });
  })();
</script>
