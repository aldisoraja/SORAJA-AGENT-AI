---
import Layout from '../layouts/Layout.astro';
import ChatMock from '../components/ChatMock.astro';
import DownloadSection from '../components/DownloadSection.astro';
import ProductSections from '../components/ProductSections.astro';
import releases from '../data/releases.json';
import '../styles/sections.css';

const APP_VERSION = releases.version;
---

<Layout>
  <div class="page-wrapper">
    <!-- Ambient Background Glows -->
    <div class="ambient-glow glow-1"></div>
    <div class="ambient-glow glow-2"></div>

    <!-- Navigation Bar -->
    <header class="navbar">
      <div class="nav-container">
        <a href="#" class="nav-brand">
          <img src="/logo-mark.png" alt="SORAJA ENGINE Logo" class="brand-logo-img" />
          <div class="brand-title-group">
            <span class="brand-name">SORAJA ENGINE</span>
            <span class="brand-pill" title={`Versi rilis terbaru: v${APP_VERSION}`}>
              <span class="pill-dot"></span>
              <span>v{APP_VERSION}</span>
            </span>
          </div>
        </a>

        <nav class="nav-menu">
          <a href="#fitur" class="nav-link">Fitur</a>
          <a href="#model-ai" class="nav-link">Agen & Model</a>
          <a href="#downloads" class="nav-link">Unduh</a>
        </nav>

        <div class="nav-actions">
          <button id="theme-toggle" class="theme-toggle-btn" aria-label="Ganti Tema Dark/Light" title="Ganti Tema">
            <span class="theme-icon sun-icon">☀️</span>
            <span class="theme-icon moon-icon">🌙</span>
          </button>
          <a href="#downloads" class="btn-primary-nav">
            <span>Unduh Aplikasi</span>
          </a>
        </div>
      </div>
    </header>

    <!-- Hero Section -->
    <section class="hero-section">
      <div class="hero-logo-banner">
        <img src="/logo.png" alt="SORAJA ENGINE" class="hero-main-logo" />
      </div>

      <div class="hero-badge">
        <span class="badge-dot"></span>
        <span class="badge-text">Claude Code • Codex • Antigravity • OpenCode • Kiro — dalam satu aplikasi desktop</span>
      </div>

      <h1 class="hero-heading">
        Agen AI Coding yang Bernalar Dalam<br />
        <span class="gradient-text">Akurat, Transparan & Mudah Dipahami</span>
      </h1>

      <p class="hero-subtext">
        <strong>SORAJA ENGINE</strong> menjalankan <strong>Claude Code</strong>, <strong>Codex</strong>, <strong>Antigravity</strong>,{' '}
        <strong>OpenCode</strong>, dan <strong>Kiro</strong> dengan akun Anda sendiri. Kirim hingga <strong>10 gambar</strong> serta dokumen <strong>PDF, Word, Excel, PowerPoint</strong> per pesan,
        lihat setiap langkah kerja agen secara langsung, tinjau perubahan kode, lalu salin jawabannya dengan satu klik.
      </p>

      <div class="hero-cta">
        <a href="#downloads" class="btn-primary-nav hero-cta-main">Unduh v{APP_VERSION}</a>
        <a href="#fitur" class="hero-cta-ghost">Lihat fitur →</a>
      </div>

      <ChatMock />

      <DownloadSection />
    </section>

    <ProductSections />

    <!-- Footer -->
    <footer class="footer">
      <div class="footer-inner">
        <div class="footer-left">
          <span class="footer-logo">⚡ SORAJA ENGINE</span>
          <p class="footer-sub">Pusat komando agen AI coding untuk desktop.</p>
        </div>
        <div class="footer-right">
          <p>© 2026 Aldi Soraja. Seluruh Hak Cipta Dilindungi.</p>
          <p class="footer-tech">Dibangun dengan Rust, Tauri v2, React 19, dan Astro.</p>
        </div>
      </div>
    </footer>
  </div>

  <!-- Tema & tinggi navbar -->
  <script is:inline>
    const themeToggleBtn = document.getElementById('theme-toggle');
    function applyTheme(theme) {
      document.documentElement.setAttribute('data-theme', theme);
      localStorage.setItem('soraja_theme', theme);
    }
    applyTheme(localStorage.getItem('soraja_theme') || 'dark');
    themeToggleBtn?.addEventListener('click', () => {
      const current = document.documentElement.getAttribute('data-theme') || 'dark';
      applyTheme(current === 'dark' ? 'light' : 'dark');
    });

    // Tinggi navbar sticky (berubah di layar sempit) untuk elemen sticky lain, mis. baris status di pratinjau Chat GUI.
    const navbar = document.querySelector('.navbar');
    if (navbar) {
      const setNavH = () => document.documentElement.style.setProperty('--nav-h', `${navbar.offsetHeight}px`);
      setNavH();
      new ResizeObserver(setNavH).observe(navbar);
    }
  </script>
</Layout>
